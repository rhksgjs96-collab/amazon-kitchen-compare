# ---------------------------------------------------------------------------
# 이 파일을 .env로 복사한 뒤 값을 채우세요.  cp .env.example .env
# .env는 .gitignore에 있어 커밋되지 않습니다. 실제 값은 절대 커밋하지 마세요.
# ---------------------------------------------------------------------------

# --- 데이터베이스 --------------------------------------------------------
# 로컬은 Docker/Postgres.app, 배포는 Neon/Supabase 무료 플랜을 추천합니다.
DATABASE_URL="postgresql://user:password@localhost:5432/amazon_compare?schema=public"

# --- Amazon Creators API -------------------------------------------------
AMAZON_CREDENTIAL_ID=""
AMAZON_CREDENTIAL_SECRET=""
AMAZON_CREDENTIAL_VERSION="3.3"
AMAZON_PARTNER_TAG=""
AMAZON_MARKETPLACE="www.amazon.com"

# --- 내부 보호용 비밀값 (openssl rand -hex 32) ---------------------------
CRON_SECRET=""
ADMIN_SECRET=""

# 배포된 사이트 주소. 네이버 블로그 글에 "비교 페이지 원본" 링크를 넣을 때 씁니다.
# 비워두면 그 링크 문단을 생략합니다.
SITE_URL=""

# ---------------------------------------------------------------------------
# 네이버 블로그 자동 업로드
# ---------------------------------------------------------------------------

# 내 블로그 주소 blog.naver.com/<여기> 부분. 필수입니다.
NAVER_BLOG_ID=""

# 네이버 로그인 정보. `npm run blog:login`으로 한 번 직접 로그인해 세션을 만들어 두면
# 비워둬도 됩니다(그 편이 캡차에 덜 걸립니다).
NAVER_ID=""
NAVER_PW=""

# 글을 넣을 블로그 카테고리 이름. 비워두면 블로그 기본 카테고리로 발행합니다.
NAVER_BLOG_CATEGORY=""

# 로그인 쿠키를 저장할 파일. .naver-blog/는 .gitignore에 있습니다.
NAVER_SESSION_PATH=".naver-blog/session.json"
NAVER_SCREENSHOT_DIR=".naver-blog/screenshots"

# 창을 띄우지 않고 돌릴지. 첫 로그인은 false(창 띄우기)를 권합니다.
NAVER_HEADLESS="true"

# 요소를 기다리는 최대 시간(ms)과, 조작 사이 간격(ms).
# 간격을 0으로 두면 사람 손보다 훨씬 빨라져 자동화로 감지되기 쉽습니다.
NAVER_TIMEOUT_MS="30000"
NAVER_SLOWMO_MS="120"

# 네이버가 화면 구조를 바꿔 선택자가 깨졌을 때, 코드를 고치지 않고 덮어쓸 JSON 파일 경로.
# 예: {"publishOpenButton": ["button.새로운_클래스"]}
NAVER_SELECTORS_FILE=""
